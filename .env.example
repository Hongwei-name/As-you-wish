# 复制为后端根目录的 .env，填写真实值。真实 .env 不提交 Git。
# 通过 Spring properties 加载：使用 KEY=value，不加引号，不使用 export。
# 在 As-you-wish 或其服务模块目录启动时自动加载，无需 local profile。
# 端口、Redis 连接与 API 文档开关直接在 application.yml 中配置。

DB_URL=jdbc:mysql://127.0.0.1:3306/im_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=your_database_user
DB_PASSWORD=replace_with_database_password

# 至少 32 个 UTF-8 字节的随机密钥；不要使用模板占位符。
JWT_SECRET=replace_with_random_secret_at_least_32_bytes
INTERNAL_SERVICE_TOKEN=replace_with_a_separate_random_token_at_least_32_bytes

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=
NACOS_PASSWORD=
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# AI 服务：完整 chat 接口地址由 OPENAI_CHAT_URL 提供，不再硬编码路径拼接。
# OPENAI_BASE_URL 只写供应商 origin；更换供应商/地址只改这两个变量。
OPENAI_API_KEY=replace_with_provider_api_key
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com
OPENAI_CHAT_URL=https://ark.cn-beijing.volces.com/api/plan/v3/chat/completions
OPENAI_MODEL=ark-code-latest

# 可选：直连不稳定时，通过 HTTP 代理访问 AI 供应商。
ASSISTANT_PROXY_HOST=
ASSISTANT_PROXY_PORT=0

# 环境隔离：test / prod，对应 application-test.yml / application-prod.yml。
SPRING_PROFILES_ACTIVE=test

# 阿里云号码认证 PNVS（短信认证）公共地址；不是 Dysms 短信服务。
# test profile 使用控制台验证码，不需要下面任何阿里云凭据；prod 才调用 PNVS。
ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com

# 测试环境：独立 RAM 子账号，最小权限 dypns:SendSmsVerifyCode / dypns:CheckSmsVerifyCode。
ALIYUN_PNVS_ACCESS_KEY_ID_TEST=
ALIYUN_PNVS_ACCESS_KEY_SECRET_TEST=
# 签名含中文时，.env 会被当作 .properties 按 ISO-8859-1 读取，必须使用 Unicode 转义。
# 例如“恒创联众”写成：ALIYUN_PNVS_SIGN_NAME_TEST=\u6052\u521b\u8054\u4f17
ALIYUN_PNVS_SIGN_NAME_TEST=
ALIYUN_PNVS_TEMPLATE_REGISTER_TEST=100001
ALIYUN_PNVS_TEMPLATE_LOGIN_TEST=100001
ALIYUN_PNVS_TEMPLATE_RESET_TEST=100003
ALIYUN_PNVS_SCHEME_REGISTER_TEST=
ALIYUN_PNVS_SCHEME_LOGIN_TEST=
ALIYUN_PNVS_SCHEME_RESET_TEST=

# 生产环境：独立 RAM 子账号与独立短信认证套餐包。
ALIYUN_PNVS_ACCESS_KEY_ID_PROD=
ALIYUN_PNVS_ACCESS_KEY_SECRET_PROD=
ALIYUN_PNVS_SIGN_NAME_PROD=
ALIYUN_PNVS_TEMPLATE_REGISTER_PROD=
ALIYUN_PNVS_TEMPLATE_LOGIN_PROD=
ALIYUN_PNVS_TEMPLATE_RESET_PROD=
ALIYUN_PNVS_SCHEME_REGISTER_PROD=
ALIYUN_PNVS_SCHEME_LOGIN_PROD=
ALIYUN_PNVS_SCHEME_RESET_PROD=
